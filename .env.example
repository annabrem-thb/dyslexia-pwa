# Copy this file to .env and fill in real values locally.
# NEVER commit .env — it is already gitignored.
# For anything beyond solo development (CI, collaborators, deployment),
# store these in your platform's secret manager (Netlify environment
# variables, GitHub Actions repository secrets, etc.) instead of a file.

# Supabase project URL (Project Settings -> API).
SUPABASE_URL=

# Supabase SERVICE ROLE key (Project Settings -> API -> service_role).
# This key bypasses Row Level Security — treat it like a root password.
# Used by netlify/functions/submit-survey and src/components/export-netlify-forms.js.
# If this key has ever been shared, committed, or logged anywhere, rotate it
# in the Supabase dashboard before using it again.
SUPABASE_SERVICE_ROLE_KEY=
